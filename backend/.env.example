PROJECT_NAME=suportum-api
API_VERSION=1.0.0
SECRET_KEY=<genera con: python -c "import secrets; print(secrets.token_hex(64))">

# Directorios de datos
# Dejar vacios para usar el default de config.py, relativo al proyecto backend:
#   DATABASE_URL -> backend/data/suportum.db
#   UPLOAD_DIR   -> backend/uploads/
# Estos directorios se crean automaticamente al arrancar el servidor si no existen.
DATABASE_URL=
UPLOAD_DIR=

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
PORT=8001
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_DIMENSION_PX=1920
MAX_LOGO_SIZE_MB=2
MAX_LOGO_DIMENSION_PX=512

# Rate limiting: max mensajes Socket.IO por usuario en la ventana de tiempo
SOCKET_MSG_RATE_MAX=30
SOCKET_MSG_RATE_WINDOW=60

# Rate limiting: login por cuenta (intentos fallidos por email+proyecto antes de bloquear)
LOGIN_RATE_LIMIT_MAX=5
# Ventana en segundos para el limite de intentos por cuenta
LOGIN_RATE_LIMIT_WINDOW=300
# Rate limiting: login por IP (intentos totales por IP antes de bloquear)
LOGIN_IP_RATE_LIMIT_MAX=30
# Ventana en segundos para el limite de intentos por IP
LOGIN_IP_RATE_LIMIT_WINDOW=300

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Retension de mensajes: se eliminan automaticamente los mas viejos que esto (con sus archivos en disco)
MESSAGE_RETENTION_DAYS=60

# AWS SES: servicio de emails transaccionales
# Dejar vacíos en desarrollo para deshabilitar envíos (el sistema continúa sin error).
# En producción: usar credenciales IAM con permisos ses:SendEmail únicamente.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
# Región donde está verificado el dominio/email en SES (default: us-east-1)
AWS_SES_REGION=us-east-1
